# User-uploaded media is private. Only handoff demo covers referenced by
# NVTDuong_AppReadBook_DB/NoVi_Database.sql are committed.
**/wwwroot/uploads/*
!**/wwwroot/uploads/test/
**/wwwroot/uploads/test/*
!**/wwwroot/uploads/test/demo-covers/
!**/wwwroot/uploads/test/demo-covers/*.jpg

# Original working copies of cover art and duplicate root-level images are
# not needed by the portable handoff; the canonical copies live above.
/Anh/
**/ReadBookApi/wwwroot/*.jpg
